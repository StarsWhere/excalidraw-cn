{
  "dependencies": {
    "@dwelle/tunnel-rat": "0.1.1",
    "clsx": "1.1.1",
    "image-blob-reduce": "3.0.1",
    "jotai": "1.6.4",
    "lodash.throttle": "4.1.1",
    "nanoid": "3.3.3",
    "open-color": "1.9.1",
    "pako": "1.0.11",
    "perfect-freehand": "1.2.0",
    "pica": "7.1.1",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "points-on-curve": "0.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "roughjs": "4.5.2",
    "sass": "1.51.0"
  },
  "devDependencies": {
    "@babel/runtime": "7.21.0",
    "@eslint/js": "^9.39.4",
    "@excalidraw/prettier-config": "1.0.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "5.16.2",
    "@testing-library/react": "16.3.0",
    "@types/chai": "4.3.0",
    "@types/jest": "27.4.0",
    "@types/lodash.throttle": "4.1.7",
    "@types/pako": "1.0.3",
    "@types/pica": "5.1.3",
    "@types/react": "18.0.15",
    "@types/react-dom": "18.0.6",
    "@types/resize-observer-browser": "0.1.7",
    "@vitejs/plugin-react": "4.4.1",
    "chai": "4.3.6",
    "concurrently": "9.2.1",
    "cross-env": "7.0.3",
    "dotenv": "16.0.1",
    "electron": "37.2.3",
    "electron-builder": "26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "7.0.4",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-canvas-mock": "2.4.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "12.3.7",
    "pepjs": "0.5.3",
    "prettier": "2.6.2",
    "ts-jest": "29.2.5",
    "typescript": "4.9.4",
    "typescript-eslint": "^8.58.0",
    "vite": "6.3.6",
    "wait-on": "8.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "build": {
    "extends": null,
    "appId": "com.handraw.desktop",
    "productName": "Handraw",
    "asar": true,
    "extraMetadata": {
      "main": "dist/main/index.cjs"
    },
    "directories": {
      "buildResources": "public",
      "output": "dist/release"
    },
    "files": [
      "dist/renderer/**/*",
      "dist/main/**/*",
      "dist/preload/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/favicon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "excalidraw",
        "name": "Handraw Scene",
        "description": "Handraw scene file",
        "role": "Editor"
      },
      {
        "ext": "excalidrawlib",
        "name": "Handraw Library",
        "description": "Handraw library file",
        "role": "Editor"
      }
    ]
  },
  "homepage": ".",
  "main": "dist/main/index.cjs",
  "name": "handraw",
  "description": "A desktop-first hand-drawn whiteboard built with Electron.",
  "author": "StarsWhere",
  "packageManager": "pnpm@10.30.3",
  "prettier": "@excalidraw/prettier-config",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "clean": "node ./scripts/build/clean.js",
    "build:electron": "node ./scripts/build/build-electron.js",
    "build:renderer": "vite build && pnpm build:version",
    "build:version": "node ./scripts/build/build-version.js",
    "build": "pnpm build:renderer && pnpm build:electron",
    "dev": "concurrently -k -s first \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 node ./scripts/dev/start-electron.cjs ./src/main/index.cjs",
    "dev:renderer": "vite",
    "check:format": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.prettierignore --list-different",
    "check:lint": "eslint --quiet --ext .js,.cjs,.mjs,.ts,.tsx .",
    "check:type": "tsc --noEmit",
    "check:test": "jest --passWithNoTests",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:type && pnpm check:test --runInBand",
    "fix:format": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.prettierignore --write",
    "fix:lint": "eslint --quiet --ext .js,.cjs,.mjs,.ts,.tsx . --fix",
    "fix": "pnpm fix:format && pnpm fix:lint",
    "prepare": "husky install",
    "package:win": "pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis portable"
  },
  "repository": "git@github.com:korbinzhao/handraw.git",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
