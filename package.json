{
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all",
      "not safari < 12",
      "not kaios <= 2.5",
      "not edge < 79",
      "not chrome < 70",
      "not and_uc < 13",
      "not samsung < 10"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "5.0.1",
    "@dwelle/tunnel-rat": "0.1.1",
    "@testing-library/jest-dom": "5.16.2",
    "@testing-library/react": "12.1.5",
    "@tldraw/vec": "1.7.1",
    "@types/jest": "27.4.0",
    "@types/pica": "5.1.3",
    "@types/react": "18.0.15",
    "@types/react-dom": "18.0.6",
    "antd": "5.4.2",
    "clsx": "1.1.1",
    "cross-env": "7.0.3",
    "i18next-browser-languagedetector": "6.1.4",
    "image-blob-reduce": "3.0.1",
    "jotai": "1.6.4",
    "lodash.throttle": "4.1.1",
    "moment": "2.29.4",
    "nanoid": "3.3.3",
    "open-color": "1.9.1",
    "pako": "1.0.11",
    "perfect-freehand": "1.2.0",
    "pica": "7.1.1",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "points-on-curve": "0.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "roughjs": "4.5.2",
    "sass": "1.51.0",
    "tunnel-rat": "0.1.0",
    "typescript": "4.9.4"
  },
  "devDependencies": {
    "@babel/runtime": "7.21.0",
    "@excalidraw/eslint-config": "1.0.0",
    "@excalidraw/prettier-config": "1.0.2",
    "@vitejs/plugin-react": "4.4.1",
    "@types/chai": "4.3.0",
    "@types/lodash.throttle": "4.1.7",
    "@types/pako": "1.0.3",
    "@types/resize-observer-browser": "0.1.7",
    "chai": "4.3.6",
    "concurrently": "9.2.1",
    "dotenv": "16.0.1",
    "electron": "37.2.3",
    "electron-builder": "26.0.12",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "3.3.1",
    "husky": "7.0.4",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-canvas-mock": "2.4.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "12.3.7",
    "pepjs": "0.5.3",
    "prettier": "2.6.2",
    "ts-jest": "29.2.5",
    "vite": "6.3.6",
    "wait-on": "8.0.5"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "build": {
    "extends": null,
    "appId": "com.handraw.desktop",
    "productName": "Handraw",
    "asar": true,
    "extraMetadata": {
      "main": "dist/electron/main.cjs"
    },
    "directories": {
      "buildResources": "public"
    },
    "files": [
      "dist/renderer/**/*",
      "dist/electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "favicon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "excalidraw",
        "name": "Handraw Scene",
        "description": "Handraw scene file",
        "role": "Editor"
      },
      {
        "ext": "excalidrawlib",
        "name": "Handraw Library",
        "description": "Handraw library file",
        "role": "Editor"
      }
    ]
  },
  "homepage": ".",
  "main": "electron/main.cjs",
  "name": "handraw",
  "description": "A desktop-first hand-drawn whiteboard built with Electron.",
  "author": "StarsWhere",
  "packageManager": "pnpm@10.30.3",
  "prettier": "@excalidraw/prettier-config",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:electron": "node ./scripts/build-electron.js",
    "build:renderer": "vite build && pnpm build:version",
    "build:version": "node ./scripts/build-version.js",
    "build": "pnpm build:renderer && pnpm build:electron",
    "dev": "concurrently -k -s first \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "dev:renderer": "vite",
    "dist:win": "pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis portable",
    "fix:code": "pnpm test:code --fix",
    "fix:other": "pnpm prettier --write",
    "fix": "pnpm fix:other && pnpm fix:code",
    "lint": "pnpm test:code",
    "prepare": "husky install",
    "prettier": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.prettierignore",
    "start": "pnpm dev",
    "start:desktop": "pnpm build && electron .",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test:other && pnpm test:app --runInBand",
    "test:app": "jest --passWithNoTests",
    "test:code": "eslint --quiet --ext .js,.ts,.tsx .",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --no-cache",
    "test:other": "pnpm prettier --list-different",
    "test:typecheck": "tsc --noEmit",
    "test:update": "pnpm test:app --updateSnapshot",
    "typecheck": "pnpm test:typecheck",
    "test": "pnpm test:app"
  },
  "repository": "git@github.com:korbinzhao/handraw.git"
}
